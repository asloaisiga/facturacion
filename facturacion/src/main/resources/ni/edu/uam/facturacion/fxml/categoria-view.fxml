<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="750.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacion.controller.CategoriaController">

    <children>
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Gestión de Categorías" textFill="#1E9DB3" />
        <VBox spacing="5.0">
            <children>
                <Label text="Nombre de la categoría" textFill="#25BFDA" />
                <TextField fx:id="txtNombre" promptText="Ingrese una categoría" />
            </children>
        </VBox>
        <CheckBox fx:id="chkActiva" mnemonicParsing="false" selected="true" text="Categoría activa" textFill="#187A8C" />
        <HBox spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#guardarCategoria" text="Guardar" textFill="white" style="-fx-background-color: #187A8C" />
                <Button mnemonicParsing="false" onAction="#actualizarCategoria" text="Actualizar" textFill="white" style="-fx-background-color: #1E9DB3" />
                <Button mnemonicParsing="false" onAction="#limpiar" text="Limpiar" textFill="white" style="-fx-background-color: #25BFDA" />
            </children>
        </HBox>
        <Separator />
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Categorías registradas" textFill="#187A8C" />
        <HBox spacing="15.0">
            <children>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Buscar" />
                        <TextField fx:id="txtBuscar" promptText="Buscar categoría..." />
                    </children>
                </VBox>
                <VBox prefWidth="180.0" spacing="5.0">
                    <children>
                        <Label text="Estado" />
                        <ComboBox fx:id="cmbFiltroEstado" maxWidth="1.7976931348623157E308" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="300.0" text="Nombre" />
                <TableColumn fx:id="colActiva" prefWidth="120.0" text="Activa" />
                <TableColumn fx:id="colAcciones" prefWidth="150.0" text="Acciones" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
