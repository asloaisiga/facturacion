<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="550.0"
      prefWidth="750.0"
      spacing="15.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.facturacion.controller.CategoriaController">

    <children>
        <Label text="Gestión de Categorías"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />
        <VBox spacing="5.0">
            <children>
                <Label text="Nombre de la categoría" />
                <TextField fx:id="txtNombre"
                           promptText="Ingrese una categoría" />
            </children>
        </VBox>
        <CheckBox fx:id="chkActiva"
                  mnemonicParsing="false"
                  selected="true"
                  text="Categoría activa" />
        <HBox spacing="10.0">
            <children>
                <Button mnemonicParsing="false"
                        onAction="#guardarCategoria"
                        text="Guardar" />
                <Button mnemonicParsing="false"
                        onAction="#actualizarCategoria"
                        text="Actualizar" />
                <Button mnemonicParsing="false"
                        onAction="#limpiar"
                        text="Limpiar" />
            </children>
        </HBox>
        <Separator />
        <Label text="Categorías registradas"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <TableView fx:id="tblCategorias"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId"
                             prefWidth="80.0"
                             text="ID" />
                <TableColumn fx:id="colNombre"
                             prefWidth="330.0"
                             text="Nombre" />
                <TableColumn fx:id="colActiva"
                             prefWidth="120.0"
                             text="Activa" />
                <TableColumn fx:id="colAcciones"
                             prefWidth="150.0"
                             text="Acciones" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0"
                left="20.0"
                right="20.0"
                top="20.0" />
    </padding>
</VBox>